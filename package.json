{
  "name": "youtube-ai-telegram-bot",
  "version": "0.1.0",
  "description": "Telegram bot that mirrors the youtube-ai-processor pipeline: YouTube playlist → Gemini categorization → Strapi import.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "node --test --import ts-node/esm tests/**/*.test.ts || node --test --require ts-node/register tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.3.1",
    "googleapis": "^171.4.0",
    "nanoid": "^3.3.7",
    "pino": "^9.5.0",
    "proper-lockfile": "^4.1.2",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/proper-lockfile": "^4.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
